{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "programas-fibra-data-scraper",
	"main": "src/entry.py",
	"compatibility_date": "2025-10-04",
	"compatibility_flags": [
		"python_workers"
	],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"*/3 * * * *",
			"0 15 1 * *",
			"59 23 LW * *"
		]
  	}
}