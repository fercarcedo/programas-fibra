{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "programas-fibra",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-13",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    {
      "binding": "BUCKET_GEO",
      "bucket_name": "programas-fibra-geo"
    }
  ],
  "kv_namespaces": [
		{
			"binding": "PROJECTS",
			"id": "7e8b779284134b108916b8ee6f3a5614"
		}
	],
  "services": [
    {
      "binding": "TILE_WORKER",
      "service": "programas-fibra-tile-server"
    }
  ]
}
