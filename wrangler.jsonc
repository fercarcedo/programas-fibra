{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "programas-fibra",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-13",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    {
      "binding": "BUCKET_GEO",
      "bucket_name": "programas-fibra-geo"
    }
  ]
}
