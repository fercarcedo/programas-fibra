{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "programas-fibra-data-scraper-scheduler",
	"main": "src/entry.py",
	"compatibility_date": "2025-08-01",
	"compatibility_flags": [
		"python_workflows",
		"python_workers"
	],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"0 2 * * SAT"
		]
  	},
	"workflows": [
    	{
      		"name": "programas-fibra-data-scraper-workflow",
      		"binding": "WORKFLOW",
      		"class_name": "DataScraperWorkflow"
    	}
  	],
	"kv_namespaces": [
		{
			"binding": "CONFIG",
			"id": "e791a9d3cddd4af3a224c2ffbf10b1a6",
			"remote": true
		},
		{
			"binding": "PROJECTS",
			"id": "7e8b779284134b108916b8ee6f3a5614",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET_GEO",
			"bucket_name": "programas-fibra-geo"
		},
	]
}